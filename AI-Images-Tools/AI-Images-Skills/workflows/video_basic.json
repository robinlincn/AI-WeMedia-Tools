{
  "0": {
    "class_type": "Note",
    "inputs": {},
    "text": "【模板说明】这是视频生成的占位工作流，节点名/模型均为示意，需替换为你机器上真实可用的工作流。\n做法：在目标 ComfyUI 中调好视频流程 → 菜单 'Export (API Format)' → 导出 JSON 覆盖本文件 → 同步更新 video_basic.params.json 的节点映射。\n本模板默认终端保存节点为 VHS_VideoCombine（ComfyUI-VideoHelperSuite），输出在 history 中位于 'gifs' 键。",
    "_meta": { "title": "视频模板说明(可删)" }
  },
  "1": {
    "class_type": "WanModelLoader",
    "inputs": { "model": "wan2.1_t2v_1.3B.safetensors" },
    "_meta": { "title": "Wan 模型(占位,按需替换)" }
  },
  "2": {
    "class_type": "WanTextEncode",
    "inputs": {
      "text": "a calm ocean at sunset, gentle waves, cinematic",
      "wan_model": ["1", 0]
    },
    "_meta": { "title": "正提示词" }
  },
  "9": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["1", 0],
      "text_embeds": ["2", 0],
      "width": 832,
      "height": 480,
      "num_frames": 25,
      "seed": 0
    },
    "_meta": { "title": "视频采样(占位)" }
  },
  "10": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["9", 0],
      "frame_rate": 16,
      "filename_prefix": "AI-Video"
    },
    "_meta": { "title": "保存视频" }
  }
}
