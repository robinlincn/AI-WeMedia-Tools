{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" },
    "_meta": { "title": "加载基础模型(checkpoint)" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "a serene mountain lake at sunrise, cinematic, highly detailed",
      "clip": ["1", 1]
    },
    "_meta": { "title": "正提示词" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, low quality, distorted, watermark",
      "clip": ["1", 1]
    },
    "_meta": { "title": "负提示词" }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "_meta": { "title": "空白潜空间(尺寸)" }
  },
  "4": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["7", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    },
    "_meta": { "title": "采样器" }
  },
  "5": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["4", 0], "vae": ["1", 2] },
    "_meta": { "title": "VAE 解码" }
  },
  "6": {
    "class_type": "SaveImage",
    "inputs": { "images": ["5", 0], "filename_prefix": "AI-Images" },
    "_meta": { "title": "保存图片" }
  }
}
